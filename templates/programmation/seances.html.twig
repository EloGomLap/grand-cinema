{% extends 'base.html.twig' %}

{% block title %}Programmation des séances{% endblock %}

{% block body %}
    <h1>Programmation des séances</h1>

    <section class="carte" style="margin-bottom: 1.5rem;">
        <h2>Programmer une séance</h2>
        {% if erreurs is not empty %}<div class="flash erreur">La séance n'a pas pu être programmée.</div>{% endif %}
        <form method="post" class="formulaire" novalidate>
            <input type="hidden" name="_token" value="{{ csrf_token('seance') }}">
            <label>Film
                <select name="seance[filmId]">
                    <option value="">Choisir un film</option>
                    {% for film in films %}<option value="{{ film.id }}" {{ (donnees.filmId ?? '') == film.id ? 'selected' }}>{{ film.titre }} ({{ film.dureeFormatee }})</option>{% endfor %}
                </select>
                {% if erreurs.filmId is defined %}<span class="erreur-champ">{{ erreurs.filmId }}</span>{% endif %}
            </label>
            <label>Salle
                <select name="seance[salleId]">
                    <option value="">Choisir une salle</option>
                    {% for salle in salles %}<option value="{{ salle.id }}" {{ (donnees.salleId ?? '') == salle.id ? 'selected' }}>{{ salle.nom }} ({{ salle.capacite }} places)</option>{% endfor %}
                </select>
                {% if erreurs.salleId is defined %}<span class="erreur-champ">{{ erreurs.salleId }}</span>{% endif %}
            </label>
            <label>Date et heure de début
                <input type="datetime-local" name="seance[debut]" value="{{ donnees.debut ?? '' }}">
                {% if erreurs.debut is defined %}<span class="erreur-champ">{{ erreurs.debut }}</span>{% endif %}
            </label>
            <label>Langue
                <select name="seance[langue]">
                    {% for langue in langues %}<option value="{{ langue }}" {{ (donnees.langue ?? '') == langue ? 'selected' }}>{{ langue }}</option>{% endfor %}
                </select>
                {% if erreurs.langue is defined %}<span class="erreur-champ">{{ erreurs.langue }}</span>{% endif %}
            </label>
            <label>Prix de la place (€)
                <input type="text" inputmode="decimal" name="seance[prix]" value="{{ donnees.prix ?? '' }}">
                {% if erreurs.prix is defined %}<span class="erreur-champ">{{ erreurs.prix }}</span>{% endif %}
            </label>
            <div class="actions"><button class="bouton" type="submit">Programmer la séance</button></div>
        </form>
    </section>

    <h2>Séances à venir</h2>
    {% if seances is empty %}
        <p class="meta">Aucune séance programmée.</p>
    {% else %}
        <table class="tableau">
            <thead><tr><th>Date</th><th>Horaire</th><th>Film</th><th>Salle</th><th>Langue</th><th>Prix</th></tr></thead>
            <tbody>
            {% for s in seances %}
                <tr>
                    <td>{{ s.dateHeureDebut|date('d/m/Y') }}</td>
                    <td>{{ s.dateHeureDebut|date('H:i') }} - {{ s.dateHeureFin|date('H:i') }}</td>
                    <td>{{ s.film.titre }}</td>
                    <td>{{ s.salle.nom }}</td>
                    <td>{{ s.langue }}</td>
                    <td>{{ s.prix|number_format(2, ',', ' ') }} €</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    {% endif %}
{% endblock %}

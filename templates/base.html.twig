<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Le Grand Cinéma{% endblock %}</title>
    <style>
        :root { --fond: #14121a; --carte: #1f1c28; --texte: #f1eee8; --doux: #a9a3b5; --accent: #e8b04b; --erreur: #ff7a6b; --ok: #6fd08c; }
        * { box-sizing: border-box; }
        body { margin: 0; font-family: system-ui, -apple-system, "Segoe UI", sans-serif; background: var(--fond); color: var(--texte); line-height: 1.5; }
        a { color: var(--accent); }
        header { display: flex; flex-wrap: wrap; gap: 1rem; align-items: center; justify-content: space-between; padding: 1rem 1.5rem; border-bottom: 1px solid #2e2a3a; }
        header .logo { font-size: 1.3rem; font-weight: 700; color: var(--texte); text-decoration: none; letter-spacing: .02em; }
        header .logo span { color: var(--accent); }
        nav { display: flex; gap: 1rem; align-items: center; flex-wrap: wrap; font-size: .95rem; }
        main { max-width: 1000px; margin: 0 auto; padding: 1.5rem; }
        h1 { margin-top: 0; }
        .bouton { display: inline-block; background: var(--accent); color: #1a1406; border: 0; border-radius: 6px; padding: .55rem 1rem; font-weight: 600; text-decoration: none; cursor: pointer; font-size: .95rem; }
        .bouton.secondaire { background: transparent; color: var(--texte); border: 1px solid #4a4458; }
        .bouton.danger { background: var(--erreur); color: #1a0703; }
        .grille { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 1rem; }
        .carte { background: var(--carte); border-radius: 10px; padding: 1rem; border: 1px solid #2e2a3a; }
        .carte h2 { font-size: 1.1rem; margin: 0 0 .3rem; }
        .meta { color: var(--doux); font-size: .9rem; }
        .flash { padding: .7rem 1rem; border-radius: 6px; margin-bottom: 1rem; }
        .flash.succes { background: rgba(111, 208, 140, .15); border: 1px solid var(--ok); }
        .flash.erreur, .erreur-champ { color: var(--erreur); }
        .flash.erreur { background: rgba(255, 122, 107, .12); border: 1px solid var(--erreur); }
        form.formulaire { display: grid; gap: 1rem; max-width: 560px; }
        label { display: grid; gap: .3rem; font-weight: 600; }
        input, textarea, select { font: inherit; padding: .55rem .7rem; border-radius: 6px; border: 1px solid #4a4458; background: #15131c; color: var(--texte); }
        .actions { display: flex; gap: .7rem; flex-wrap: wrap; align-items: center; }
        .filtres { display: flex; gap: .5rem; margin-bottom: 1rem; flex-wrap: wrap; }
        .affiche { max-width: 220px; border-radius: 8px; }
        ul.seances { list-style: none; padding: 0; display: grid; gap: .4rem; }
        .plan { display: grid; gap: .35rem; justify-content: center; margin: 1rem 0; }
        .plan .ecran { text-align: center; color: var(--doux); border-top: 3px solid var(--doux); padding-top: .2rem; margin-bottom: .6rem; font-size: .85rem; }
        .plan .rang { display: flex; gap: .35rem; align-items: center; }
        .plan .rang > span { width: 1.4rem; color: var(--doux); font-size: .85rem; }
        .siege { width: 2.1rem; height: 2.1rem; display: grid; place-items: center; border-radius: 6px 6px 3px 3px; font-size: .7rem; background: #2f6b45; color: #fff; position: relative; }
        .siege.pris { background: #4a4458; color: #8d869c; text-decoration: line-through; }
        .siege.pmr { outline: 2px solid #6ba3ff; }
        .siege input { position: absolute; inset: 0; opacity: 0; cursor: pointer; margin: 0; }
        .siege:has(input:checked) { background: var(--accent); color: #1a1406; }
        .legende { display: flex; gap: 1rem; flex-wrap: wrap; justify-content: center; font-size: .85rem; color: var(--doux); }
        .billet { text-align: center; max-width: 420px; margin: 0 auto; }
        .billet.presentation { max-width: none; background: #fff; color: #111; display: flex; flex-direction: column; justify-content: center; align-items: center; }
        .billet.presentation #presenter, .billet.presentation .meta { display: none; }
        .qr { background: #fff; padding: 10px; border-radius: 8px; margin: .6rem auto; box-sizing: content-box; }
        .qr img, .qr canvas { width: 100%; height: 100%; }
        .billets { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 1rem; }
        .code { word-break: break-all; font-family: monospace; }
        .tableau { width: 100%; border-collapse: collapse; margin-bottom: 1rem; }
        .tableau th, .tableau td { text-align: left; padding: .5rem .6rem; border-bottom: 1px solid #2e2a3a; vertical-align: middle; }
        .tableau th { color: var(--doux); font-weight: 600; font-size: .9rem; }
        .badge { display: inline-block; padding: .1rem .5rem; border-radius: 999px; background: #2e2a3a; font-size: .85rem; }
        .badge.ok { background: rgba(111, 208, 140, .2); color: var(--ok); }
        .badge.ko { background: rgba(255, 122, 107, .2); color: var(--erreur); }
    </style>
</head>
<body>
<header>
    <a class="logo" href="{{ path('accueil') }}">Le Grand <span>Cinéma</span></a>
    <nav>
        <a href="{{ path('seance_index') }}">Séances</a>
        <a href="{{ path('film_index') }}">Films</a>
        <a href="{{ path('api_doc') }}">API (Swagger)</a>
        {% if is_granted('ROLE_PROGRAMMATEUR') %}<a href="{{ path('programmation_seances') }}">Programmation</a>{% endif %}
        {% if is_granted('ROLE_ADMIN') %}<a href="{{ path('admin_utilisateurs') }}">Comptes</a>{% endif %}
        {% if app.user %}
            <a href="{{ path('compte_billets') }}">Mes billets</a>
            <span class="meta">{{ app.user.prenom }} {{ app.user.nom }} ({{ app.user.role|lower }})</span>
            <a href="{{ path('app_logout') }}">Déconnexion</a>
        {% else %}
            <a href="{{ path('app_login') }}">Connexion</a>
            <a href="{{ path('compte_inscription') }}">Créer un compte</a>
        {% endif %}
    </nav>
</header>
<main>
    {% for message in app.flashes('succes') %}
        <div class="flash succes">{{ message }}</div>
    {% endfor %}
    {% for message in app.flashes('erreur') %}
        <div class="flash erreur">{{ message }}</div>
    {% endfor %}
    {% block body %}{% endblock %}
</main>
<script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js" defer></script>
<script>
    // Dessine les QR codes des billets présents dans la page
    window.addEventListener('load', function () {
        if (typeof QRCode === 'undefined') { return; }
        document.querySelectorAll('.qr[data-code]').forEach(function (zone) {
            new QRCode(zone, { text: zone.dataset.code, width: zone.clientWidth, height: zone.clientHeight, correctLevel: QRCode.CorrectLevel.M });
        });
    });
</script>
</body>
</html>

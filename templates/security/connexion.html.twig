{% extends 'base.html.twig' %}

{% block title %}Connexion - Le Grand Cinéma{% endblock %}

{% block body %}
    <h1>Connexion</h1>
    {% if erreur %}
        <div class="flash erreur">Email ou mot de passe incorrect.</div>
    {% endif %}
    <form method="post" class="formulaire">
        <label>Email
            <input type="email" name="_username" value="{{ dernier_email }}" required autofocus autocomplete="email">
        </label>
        <label>Mot de passe
            <input type="password" name="_password" required autocomplete="current-password">
        </label>
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
        <div class="actions"><button class="bouton" type="submit">Se connecter</button></div>
    </form>
{% endblock %}

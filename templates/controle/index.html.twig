{% extends 'base.html.twig' %}

{% block title %}Contrôle des billets{% endblock %}

{% block body %}
    <h1>Contrôle des billets</h1>

    {% if resultat %}
        <div class="resultat-controle {{ resultat.accepte ? 'accepte' : 'refuse' }}" role="status">
            <strong>{{ resultat.accepte ? 'ENTRÉE AUTORISÉE' : 'ENTRÉE REFUSÉE' }}</strong>
            <div>{{ resultat.message }}</div>
            {% if resultat.billet %}<div class="meta">{{ resultat.billet.seance.film.titre }} - {{ resultat.billet.seance.dateHeureDebut|date('d/m H:i') }}</div>{% endif %}
        </div>
    {% endif %}

    <form method="post" class="formulaire" id="form-controle">
        <input type="hidden" name="_token" value="{{ csrf_token('controle') }}">
        <label>Code du billet (scannez le QR code)
            <input type="text" name="code" id="code" autofocus autocomplete="off" required>
        </label>
        <div class="actions">
            <button class="bouton" type="submit">Valider</button>
            <button class="bouton secondaire" type="button" id="camera" hidden>Scanner avec la caméra</button>
        </div>
        <video id="video" playsinline muted hidden style="max-width: 100%; border-radius: 8px;"></video>
    </form>
    <script>
        // Lecture du QR code par la caméra, si le navigateur sait détecter les QR codes (Chrome, Android)
        (function () {
            if (!('BarcodeDetector' in window)) { return; }
            const bouton = document.getElementById('camera');
            const video = document.getElementById('video');
            bouton.hidden = false;
            bouton.addEventListener('click', async function () {
                const flux = await navigator.mediaDevices.getUserMedia({ video: { facingMode: 'environment' } });
                video.srcObject = flux; video.hidden = false; await video.play();
                const detecteur = new BarcodeDetector({ formats: ['qr_code'] });
                const lire = async function () {
                    const codes = await detecteur.detect(video);
                    if (codes.length > 0) {
                        flux.getTracks().forEach(function (t) { t.stop(); });
                        document.getElementById('code').value = codes[0].rawValue;
                        document.getElementById('form-controle').submit();
                        return;
                    }
                    requestAnimationFrame(lire);
                };
                lire();
            });
        })();
    </script>
{% endblock %}

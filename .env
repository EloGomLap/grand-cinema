# Variables d'environnement par défaut (aucun secret réel ici).
# Les valeurs propres à une machine se mettent dans .env.local (non versionné).
APP_ENV=dev
APP_DEBUG=1
APP_SECRET=a_remplacer_en_production
# SQLite en développement : la base est un simple fichier dans var/
DATABASE_URL="sqlite:///%kernel.project_dir%/var/data.db"
